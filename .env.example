# Runtime database connection used by the contact route.
DATABASE_URL=
# Optional direct/unpooled connection used by Drizzle Kit and migrations.
DATABASE_URL_UNPOOLED=

# Resend notification configuration. Leave unset until the domain/from address is verified.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Secret used to HMAC client IPs before storing them for rate limiting. Keep server-side only.
CONTACT_HASH_SECRET=

# Public site origin for future links and metadata.
SITE_URL=
