# Runtime database connection used by the contact route.
DATABASE_URL=
# Optional direct/unpooled connection used by Drizzle Kit and migrations.
DATABASE_URL_UNPOOLED=

# Resend email notification configuration (Gmail / Email alerts).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_NOTIFICATION_EMAIL=
CONTACT_FROM_EMAIL=

# Chrome Web Push (VAPID) notification configuration.
# VAPID_PUBLIC_KEY may be shared with the authenticated admin browser; keep VAPID_PRIVATE_KEY server-only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# Official Meta WhatsApp Business Platform Cloud API configuration.
# Leave unset until business verification and phone number provisioning are completed.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_NOTIFICATION_RECIPIENT=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Secret used to HMAC client IPs before storing them for rate limiting. Keep server-side only.
CONTACT_HASH_SECRET=

# Public HTTP(S) origin used for canonical links, sitemap, robots and sharing metadata.
# The SEO helper safely falls back to the verified deployment when this is unset or invalid.
SITE_URL=https://theseif.vercel.app
NEXT_PUBLIC_SITE_URL=https://theseif.vercel.app

# Optional public Google Search Console HTML-tag verification token.
# Paste only the exact content value issued for this property; it is rendered
# in public HTML. Leave blank until ownership verification is being completed.
GOOGLE_SITE_VERIFICATION=

# Private CMS: enable only AFTER applying reviewed migrations to the target database.
# false keeps the existing public site on its checked-in content and admin APIs closed.
CMS_ENABLED=false
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub OAuth callback: https://theseif.vercel.app/api/auth/callback/github
# Private Vercel Blob: connect a PRIVATE store with OIDC (BLOB_STORE_ID),
# or provide BLOB_READ_WRITE_TOKEN server-side. Never use NEXT_PUBLIC_* for secrets.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
